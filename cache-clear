#!/usr/bin/env bash
# cache-clear — safe cache cleaner for Hermes Agent
#
# Install:  curl -sL https://raw.githubusercontent.com/Aldo-f/cache-clear/main/cache-clear | bash
# Usage:    cache-clear [--dry-run|--force|--uninstall|--help]
#
# Clears stale temp data from ~/.hermes/cache while preserving
# expensive-to-rebuild JSON caches and active session files.

set -euo pipefail

CACHE_ROOT="${HERMES_HOME:-$HOME/.hermes}/cache"
INSTALL_DIR="${HERMES_INSTALL_DIR:-$HOME/.local/bin}"
CMD_NAME="cache-clear"
LOG_FILE="${CACHE_ROOT}/clean.log"

SAFE_DIRS=(
    scratch/terminal-output scratch/node-compile-cache
    scratch/hermes-dm-* scratch/hermes_kernel_*
    scratch/org.chromium.Chromium.* scratch/agent-browser-*
    scratch/page*.html scratch/hermes-snap-*.sh
    scratch/hermes-pty-active-*.json scratch/.last_prune
    terminal-output exec web documents delegation
    browser-use blocked-scripts screenshots images videos audio vision spillover
)

DRY_RUN=false
FORCE=false

log() {
    local msg="[ $(date '+%Y-%m-%d %H:%M:%S') ] $*"
    echo "$msg"
    mkdir -p "$CACHE_ROOT" 2>/dev/null || true
    echo "$msg" >> "$LOG_FILE" 2>/dev/null || true
}

get_size() { du -sh "$1" 2>/dev/null | cut -f1; }

show_help() {
    cat <<EOF
cache-clear — safe Hermes cache cleaner

Usage:
  $CMD_NAME              Interactive (preview, then confirm)
  $CMD_NAME --dry-run    Preview only, delete nothing
  $CMD_NAME --force      Delete without confirmation
  $CMD_NAME --uninstall  Remove this command
  $CMD_NAME --help       Show this help

Clears stale temp from: $CACHE_ROOT
Preserves: root-level JSON caches, active sessions, clean.log
EOF
}

do_clean() {
    mkdir -p "$CACHE_ROOT"
    cd "$CACHE_ROOT"

    local total_before
    total_before=$(du -sh . 2>/dev/null | cut -f1)

    log "=== Cache clear started ==="
    log "Cache root: $CACHE_ROOT"
    log "Size before: $total_before"
    log "Mode: $([[ "$DRY_RUN" == "true" ]] && echo "DRY RUN" || echo "DELETE")"

    local targets=()
    for pattern in "${SAFE_DIRS[@]}"; do
        for match in $pattern; do
            [[ -e "$match" ]] && targets+=("$match")
        done
    done

    if [[ ${#targets[@]} -eq 0 ]]; then
        log "Nothing to clean — cache is already empty."
        return 0
    fi

    log "Targets (${#targets[@]}):"
    for t in "${targets[@]}"; do
        local sz
        sz=$(get_size "$t")
        log "  $sz  $t"
    done

    if [[ "$DRY_RUN" == "true" ]]; then
        log "=== DRY RUN — nothing deleted ==="
        return 0
    fi

    if [[ "$FORCE" != "true" ]]; then
        echo ""
        read -rp "Delete the above? [y/N] " answer
        case "$answer" in
            [yY][eE][sS]|[yY]) ;;
            *) log "Cancelled."; return 0 ;;
        esac
    fi

    for t in "${targets[@]}"; do
        rm -rf "$t"
        log "  deleted: $t"
    done

    find . -maxdepth 1 -name '*.tmp' -delete 2>/dev/null || true

    local total_after
    total_after=$(du -sh . 2>/dev/null | cut -f1)
    log "Size after: $total_after"
    log "=== Cache clear complete ==="
    echo ""
    echo "Before: $total_before  →  After: $total_after"
}

# ── Self-install when piped to bash ─────────────────────────────
# Uses a quoted heredoc so nothing inside is expanded — the embedded
# script is written verbatim to ~/.local/bin/cache-clear.
self_install() {
    mkdir -p "$INSTALL_DIR"
    local target="$INSTALL_DIR/$CMD_NAME"

    cat <<'INSTALL_SCRIPT' > "$target"
