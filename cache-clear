# ── Main ───────────────────────────────────────────────────────
main() {
    # Self-install when piped to bash (no backing script file).
    # When run via `curl | bash`, BASH_SOURCE[0] is empty or doesn't
    # point to a real file on disk.
    local src="${BASH_SOURCE[0]:-}"
    if [[ ! -f "$src" ]]; then
        self_install
        exit 0
    fi

    case "${1:-}" in
        --install)   self_install; exit 0 ;;
        --uninstall) rm -f "$INSTALL_DIR/$CMD_NAME"; echo "Uninstalled: $INSTALL_DIR/$CMD_NAME"; exit 0 ;;
        --help|-h)  show_help; exit 0 ;;
        --dry-run)   DRY_RUN=true ;;
        --force)     FORCE=true ;;
    esac

    do_clean
}

main "$@"
